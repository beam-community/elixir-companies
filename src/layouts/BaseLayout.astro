---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'directory';
}

const {
  title = 'Elixir Companies',
  description = 'A curated directory of companies using Elixir in production.',
  active = 'home',
} = Astro.props;

const REPO = 'https://github.com/beam-community/elixir-companies';
const links = [
  { href: '/companies', label: 'Directory', key: 'directory' },
  { href: '/#industries', label: 'Industries' },
  { href: '/#why', label: 'Why Elixir' },
  { href: REPO, label: 'GitHub', external: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="icon" href="/images/favicon/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <meta name="theme-color" content="#1C0E2B" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/elixircompanies_logo.png" />

    <!-- Runs before first paint so there is no flash of the wrong theme.
         A saved choice wins; otherwise follow the system setting. -->
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="bg-plum text-plum-text">
      <div class="container-page">
        <nav class="flex flex-wrap items-center justify-between gap-4 py-5" aria-label="Main">
          <a href="/" class="flex items-center gap-2.5 text-plum-text no-underline hover:text-white">
            <Logo cutout="#1C0E2B" />
            <span class="font-display text-xl font-bold tracking-[-0.01em]">elixir companies</span>
          </a>

          <div class="flex items-center gap-1 md:order-last">
            <button
              id="theme-btn"
              type="button"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-plum-soft hover:bg-plum-raised hover:text-white"
              aria-label="Switch to dark theme"
              title="Switch to dark theme"
            >
              <!-- Moon in light mode, sun in dark mode -->
              <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
              <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            </button>
            <button
              id="menu-btn"
              type="button"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-plum-soft hover:bg-plum-raised md:hidden"
              aria-label="Toggle menu"
              aria-expanded="false"
              aria-controls="menu"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </button>
          </div>

          <div id="menu" class="hidden w-full flex-col gap-1 md:flex md:w-auto md:flex-row md:items-center">
            {links.map((l) => (
              <a
                href={l.href}
                {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                aria-current={l.key === active ? 'page' : undefined}
                class:list={[
                  'px-3.5 py-3 text-[15px] no-underline',
                  l.key === active
                    ? 'font-semibold text-white md:border-b-2 md:border-amber'
                    : 'font-medium text-plum-soft hover:text-white',
                ]}
              >
                {l.label}
              </a>
            ))}
            <a href="/#add" class="btn-amber mt-2 h-11 rounded-full px-[18px] text-[15px] md:ml-2 md:mt-0">Add your company</a>
          </div>
        </nav>

        <slot name="hero" />
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line bg-surface">
      <div class="container-page flex flex-wrap items-center justify-between gap-5 py-10 text-sm text-muted">
        <div class="flex items-center gap-2.5">
          <Logo size={20} fill="currentColor" class="text-link" />
          <span>A <a href="https://github.com/beam-community">beam-community</a> project · MIT licensed</span>
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/companies" class="py-2.5">Directory</a>
          <a href={REPO} class="py-2.5">GitHub</a>
          <a href="https://elixir-lang.org" class="py-2.5">elixir-lang.org</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('menu');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        menu?.classList.toggle('flex', open);
        btn.setAttribute('aria-expanded', String(open));
      });

      // Theme toggle. Only a choice that differs from the system setting is saved,
      // so flipping back to match the system returns to following it.
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-btn');
      const system = matchMedia('(prefers-color-scheme: dark)');
      const readSaved = () => {
        try { return localStorage.getItem('theme'); } catch { return null; }
      };
      const apply = (dark: boolean) => {
        root.classList.toggle('dark', dark);
        const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
        themeBtn?.setAttribute('aria-label', label);
        themeBtn?.setAttribute('title', label);
      };
      apply(root.classList.contains('dark'));
      themeBtn?.addEventListener('click', () => {
        const dark = !root.classList.contains('dark');
        try {
          if (dark === system.matches) localStorage.removeItem('theme');
          else localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
        apply(dark);
      });
      system.addEventListener('change', (e) => {
        if (!readSaved()) apply(e.matches);
      });
    </script>
  </body>
</html>
