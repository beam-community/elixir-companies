---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndustryTag from '../../components/IndustryTag.astro';
import { getCollection, render } from 'astro:content';
import { toSlug } from '../../utils/slug';
import { absoluteUrl, beamStack, displayUrl, formatLocation } from '../../utils/company';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((company) => ({
    params: { slug: toSlug(company.id) },
    props: { company, companies },
  }));
}

const { company, companies } = Astro.props;
const { Content } = await render(company);
const d = company.data;

const REPO = 'https://github.com/beam-community/elixir-companies';
const file = company.filePath?.split('/').pop() ?? `${company.id}.md`;
const website = absoluteUrl(d.website);
const place = formatLocation(d.location);
const primary = d.industry[0];
const stack = beamStack(company.body ?? '');

const sameIndustry = companies.filter((c) => c.id !== company.id && c.data.industry.includes(primary));
const related = sameIndustry.slice(0, 3);

const details = [
  { label: 'Website', value: displayUrl(d.website), href: website },
  d.github && { label: 'GitHub', value: d.github.replace(/^https?:\/\/github\.com\//, '').replace(/\/$/, ''), href: d.github },
  d.blog && { label: 'Blog', value: displayUrl(d.blog), href: d.blog },
  d.jobs && { label: 'Careers', value: 'Open roles', href: d.jobs },
  place && { label: 'Location', value: place },
  { label: 'Industry', value: d.industry.join(', ') },
  { label: 'Updated', value: d.lastChangedOn.toISOString().slice(0, 10), mono: true },
].filter(Boolean) as { label: string; value: string; href?: string; mono?: boolean }[];
---

<BaseLayout title={`${d.name} | Elixir Companies`} description={`${d.name}: ${d.industry.join(', ')} company using Elixir in production.`} active="directory">
  <nav slot="hero" aria-label="Breadcrumb" class="pb-[120px] pt-6">
    <ol class="m-0 flex list-none flex-wrap gap-2 p-0 text-sm text-plum-dim">
      <li><a href="/companies" class="text-plum-soft hover:text-white">Directory</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/companies?industry=${encodeURIComponent(primary)}`} class="text-plum-soft hover:text-white">{primary}</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-plum-text" aria-current="page">{d.name}</li>
    </ol>
  </nav>

  <div class="container-page -mt-24 pb-24">
    <!-- Identity -->
    <section class="card flex flex-wrap items-center justify-between gap-7 rounded-[28px] p-7 shadow-[0_20px_50px_rgba(28,14,43,0.08)] md:p-9">
      <div class="flex min-w-0 flex-[1_1_480px] flex-wrap items-center gap-6">
        <span class="flex h-[88px] w-[88px] shrink-0 items-center justify-center rounded-3xl bg-elixir-600 font-display text-[40px] font-extrabold text-white" aria-hidden="true">{d.name[0]}</span>
        <div class="min-w-0">
          <h1 class="font-display text-[clamp(34px,4vw,48px)] font-extrabold leading-[1.05] tracking-[-0.025em]">{d.name}</h1>
          <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-2 text-[15px] text-muted">
            {place && (
              <span class="inline-flex items-center gap-1.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
                {place}
              </span>
            )}
            {d.industry.map((ind) => <IndustryTag industry={ind} />)}
            {d.jobs && <span class="pill-hiring">Hiring</span>}
          </div>
        </div>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <a href={website} target="_blank" rel="noopener" class="inline-flex h-12 items-center gap-2 rounded-[14px] bg-elixir-600 px-5 text-[15px] font-semibold text-white no-underline hover:bg-elixir-700 hover:text-white">
          Visit website
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
        {d.jobs && (
          <a href={d.jobs} target="_blank" rel="noopener" class="inline-flex h-12 items-center rounded-[14px] border border-[#D9D3E2] px-5 text-[15px] font-semibold text-ink no-underline hover:border-elixir-600 hover:text-elixir-600">See open roles</a>
        )}
      </div>
    </section>

    <div class="mt-6 flex flex-wrap items-start gap-6">
      <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-6">
        <section class="card rounded-3xl p-7 md:p-9">
          <h2 class="mb-4 font-display text-[26px] font-bold tracking-[-0.015em]">About</h2>
          {company.body?.trim() ? (
            <div class="prose max-w-none text-[17px] leading-[1.7] text-[#3A3346] prose-a:text-elixir-600">
              <Content />
            </div>
          ) : (
            <p class="text-[17px] text-muted">
              No description yet. <a href={`${REPO}/edit/main/src/content/companies/${file}`}>Add one on GitHub</a>.
            </p>
          )}
        </section>

        {stack.length > 0 && (
          <section class="rounded-3xl bg-plum p-7 text-plum-text md:p-9">
            <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em] text-plum-dim">How they use Elixir</p>
            <h2 class="mb-6 font-display text-[26px] font-bold tracking-[-0.015em]">Their BEAM stack</h2>
            <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
              {stack.map((t) => (
                <li class="inline-flex items-center gap-2 rounded-xl bg-plum-raised px-3.5 py-2.5 text-[15px] font-medium">
                  <span class="h-2 w-2 rounded-full bg-amber" aria-hidden="true"></span>{t}
                </li>
              ))}
            </ul>
            <p class="mt-5 text-sm text-plum-dim">Drawn from the company's listing.</p>
          </section>
        )}

        {related.length > 0 && (
          <section>
            <div class="mb-4 mt-4 flex items-baseline justify-between gap-3">
              <h2 class="font-display text-[26px] font-bold tracking-[-0.015em]">More in {primary}</h2>
              <a href={`/companies?industry=${encodeURIComponent(primary)}`} class="py-3 text-[15px] font-semibold">All {sameIndustry.length + 1} →</a>
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3.5">
              {related.map((r) => (
                <a href={`/companies/${toSlug(r.id)}`} class="card flex items-center gap-3 rounded-2xl p-[18px] text-ink no-underline hover:border-elixir-600 hover:text-ink">
                  <span class="avatar h-10 w-10 rounded-xl">{r.data.name[0]}</span>
                  <span class="min-w-0">
                    <span class="block truncate font-semibold">{r.data.name}</span>
                    <span class="block truncate text-[13px] text-muted">{formatLocation(r.data.location) || r.data.industry[0]}</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="flex min-w-0 flex-[1_1_300px] flex-col gap-6">
        <section class="card rounded-3xl p-7">
          <h2 class="mb-2 font-mono text-xs font-medium uppercase tracking-[0.08em] text-muted">Details</h2>
          <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-4 text-[15px]">
            {details.map((row) => (
              <Fragment>
                <dt class="border-t border-[#EFEBF4] py-3 text-muted">{row.label}</dt>
                <dd class:list={['m-0 break-words border-t border-[#EFEBF4] py-3 text-right', row.mono && 'font-mono text-sm']}>
                  {row.href ? <a href={row.href} target="_blank" rel="noopener">{row.value}</a> : row.value}
                </dd>
              </Fragment>
            ))}
          </dl>
        </section>
        <section class="rounded-3xl bg-elixir-50 p-7">
          <h2 class="mb-2 font-display text-xl font-bold">Something out of date?</h2>
          <p class="mb-[18px] text-[15px] leading-relaxed text-[#4A4358]">
            This listing lives in <code class="rounded-md bg-white px-1.5 py-0.5 font-mono text-[13px]">{file}</code>. Edits are welcome.
          </p>
          <a href={`${REPO}/edit/main/src/content/companies/${file}`} class="inline-flex h-11 items-center gap-2 rounded-xl border border-[#D9D3E2] bg-white px-4 text-sm font-semibold text-ink no-underline hover:border-elixir-600 hover:text-elixir-600">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
            Edit on GitHub
          </a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
