---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchFilter from '../../components/SearchFilter';
import { getCollection } from 'astro:content';
import type { CompanyData } from '../../utils/search';
import { toSlug } from '../../utils/slug';
import { absoluteUrl, countBy, formatLocation, normalizeCountry, plainDescription } from '../../utils/company';

const companies = await getCollection('companies');

const companiesData: CompanyData[] = companies.map((c) => ({
  slug: toSlug(c.id),
  name: c.data.name,
  website: absoluteUrl(c.data.website),
  github: c.data.github,
  jobs: c.data.jobs,
  industry: c.data.industry,
  place: formatLocation(c.data.location),
  country: normalizeCountry(c.data.location.country),
  lastChangedOn: c.data.lastChangedOn.toISOString().slice(0, 10),
  description: plainDescription(c.body ?? ''),
}));

const industries = countBy(companies, (c) => c.data.industry);
const countries = countBy(companiesData, (c) => [c.country]).map(([name]) => name);
---

<BaseLayout
  title="Directory | Elixir Companies"
  description={`Search ${companies.length} companies using Elixir in production, by industry, country and more.`}
  active="directory"
>
  <div slot="hero" class="pb-[120px] pt-10">
    <h1 class="font-display text-[clamp(36px,5vw,56px)] font-extrabold leading-[1.05] tracking-[-0.03em]">The directory</h1>
    <p class="mt-3 text-lg text-plum-soft">
      {companies.length} companies using Elixir in production, across {industries.length} industries.
    </p>
  </div>

  <div class="container-page pb-24">
    <SearchFilter client:load companies={companiesData} industries={industries} countries={countries} />
  </div>
</BaseLayout>
